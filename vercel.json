{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": "gateway",
      "framework": "express",
      "bindings": [
        { "type": "service", "service": "ev-reservation-service", "format": "url", "env": "RESERVATION_URL" },
        { "type": "service", "service": "ev-billing-service", "format": "url", "env": "BILLING_URL" },
        { "type": "service", "service": "footprint-service", "format": "url", "env": "FOOTPRINT_URL" },
        { "type": "service", "service": "offset-service", "format": "url", "env": "OFFSET_URL" },
        { "type": "service", "service": "journey-planner-service", "format": "url", "env": "JOURNEY_URL" }
      ]
    },
    "ev-billing-service": {
      "root": "services/ev-billing-service",
      "framework": "express"
    },
    "ev-reservation-service": {
      "root": "services/ev-reservation-service",
      "framework": "express"
    },
    "footprint-service": {
      "root": "services/footprint-service",
      "framework": "express"
    },
    "journey-planner-service": {
      "root": "services/journey-planner-service",
      "framework": "express"
    },
    "offset-service": {
      "root": "services/offset-service",
      "framework": "express",
      "bindings": [
        { "type": "service", "service": "footprint-service", "format": "url", "env": "FOOTPRINT_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "gateway" } }
  ]
}
